{
  "name": "@advo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SWC_NODE_PROJECT=../../tsconfig.runtime.json node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "SWC_NODE_PROJECT=../../tsconfig.runtime.json node --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: pending eslint config'",
    "test": "vitest run --passWithNoTests",
    "admin:bootstrap": "SWC_NODE_PROJECT=../../tsconfig.runtime.json node --import @swc-node/register/esm-register src/admin-bootstrap.ts",
    "smoke": "SWC_NODE_PROJECT=../../tsconfig.runtime.json node --import @swc-node/register/esm-register src/smoke-e2e.ts",
    "seed:demo": "SWC_NODE_PROJECT=../../tsconfig.runtime.json node --import @swc-node/register/esm-register src/seed-demo.ts",
    "seed:plans": "SWC_NODE_PROJECT=../../tsconfig.runtime.json node --import @swc-node/register/esm-register src/seed-plans.ts"
  },
  "dependencies": {
    "@advo/backend": "workspace:*",
    "@advo/config": "workspace:*",
    "@advo/contracts": "workspace:*",
    "@advo/db": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "dotenv": "^17.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
