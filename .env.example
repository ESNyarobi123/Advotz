# Advo TZ environment. Copy to `.env` for host development (API/worker/web/portal on this
# machine, Postgres/Redis from infra/docker/compose.dev.yml), or to `.env.production` for
# infra/docker/compose.prod.yml. Placeholders are rejected when NODE_ENV=production.
# Generate secrets with:  openssl rand -base64 32
#
# Compose note: variables exported in your shell take precedence over --env-file values.
# Run production Compose commands from a clean shell (or `env -i PATH="$PATH" HOME="$HOME" …`).

NODE_ENV=development
APP_NAME="Advo TZ"
BUSINESS_TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_CURRENCY=TZS

# ── Origins ──────────────────────────────────────────────────────────────────
WEB_PORT=3000
PORTAL_PORT=3001
API_PORT=4000
WEB_PUBLIC_URL=http://localhost:3000
PORTAL_PUBLIC_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
# Host development value; compose.prod.yml overrides it with http://api:4000.
API_INTERNAL_URL=http://localhost:4000

# Browser-visible values inlined into the Next.js bundles at build time (host development).
# compose.prod.yml derives them from WEB_PUBLIC_URL / PORTAL_PUBLIC_URL. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# ── Data stores ──────────────────────────────────────────────────────────────
POSTGRES_DB=advo
POSTGRES_USER=advo
# Use a URL-safe value (letters, digits, - _): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace_for_your_environment
# Host development value; compose.prod.yml builds its own from POSTGRES_* with host "postgres".
DATABASE_URL=postgresql://advo:replace_for_your_environment@localhost:5432/advo
# Integration tests only; the database name must end in _test (it is truncated).
TEST_DATABASE_URL=postgresql://advo:replace_for_your_environment@localhost:5432/advo_test
REDIS_URL=redis://localhost:6379

# ── Sessions and security ────────────────────────────────────────────────────
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=86400
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# true only behind the Caddy proxy (it replaces client-supplied X-Forwarded-For).
TRUST_PROXY=false
SECRETS_ENCRYPTION_KEY=replace_with_generated_key_32chars_min
VOUCHER_LOOKUP_HMAC_KEY=replace_with_generated_key_32chars_min
ADMIN_MFA_REQUIRED=true
# Development-only fixed Admin TOTP code: when set to 6 digits and NODE_ENV != production,
# Admin sign-in and MFA enrollment accept this one code forever instead of a rotating one,
# so you do not need an authenticator app. The API refuses to boot in production if it is set.
# Leave empty to always require the real rotating authenticator code.
DEV_FIXED_OTP=
# redis (shared across API replicas) | memory (single-process development only)
RATE_LIMIT_BACKEND=redis

# ── Payments (Snippe) ────────────────────────────────────────────────────────
# fake = local simulator; rejected in production.
PAYMENT_PROVIDER=fake
PAYMENTS_MODE=centralized
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_WEBHOOK_URL=
SNIPPE_API_DOC_VERSION=2026-01-25
# Identifies the merchant account in inbox/idempotency keys; set to the real account id.
SNIPPE_ACCOUNT_ID=
# Webhooks older than this (seconds) are rejected as replays.
SNIPPE_WEBHOOK_MAX_AGE_SECONDS=3600
ALLOW_LIVE_FINANCIAL_TESTS=false

# ── Omada Controller ─────────────────────────────────────────────────────────
# fake = simulator; rejected in production.
OMADA_MODE=fake
OMADA_CONTROLLER_TYPE=software
OMADA_BASE_URL=
OMADA_CONTROLLER_ID=
OMADA_CONTROLLER_VERSION=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_HOTSPOT_OPERATOR_USERNAME=
OMADA_HOTSPOT_OPERATOR_PASSWORD=
OMADA_CA_CERT_PATH=
# Path to the OpenAPI document exported from YOUR Controller (see docs/integrations/omada-contracts.md).
OMADA_OPENAPI_CONTRACT_PATH=

# ── Notifications ────────────────────────────────────────────────────────────
# fake records messages without delivering them; the UI labels them as not delivered.
NOTIFICATION_PROVIDER=fake
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
PUBLIC_SUPPORT_CONTACT=

# ── Background processing ────────────────────────────────────────────────────
# true = API dispatches outbox events in-process (tests/single-process dev). Rejected in production.
OUTBOX_INLINE=false
WORKER_CONCURRENCY=8

# ── Operations ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Enables GET /api/v1/internal/metrics (Bearer token). Empty = endpoint disabled.
METRICS_TOKEN=

# ── Production Compose only ──────────────────────────────────────────────────
# Proxy ports on the host, backup schedule and image naming.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
BACKUP_DIR=../../backups
ADVO_IMAGE_PREFIX=advo
ADVO_IMAGE_TAG=latest

# ── First Admin (pnpm admin:bootstrap only; remove after use) ────────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
