generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity ───────────────────────────────

enum UserRole {
  ADMIN
  RESELLER
  AGENT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ResellerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OnboardingStep {
  PROFILE
  PLAN
  SITE
  DEVICE
  COMPLETE
}

enum AttributionSource {
  SELF_REFERRAL_CODE
  AGENT_INVITATION
  ADMIN_CORRECTION
}

enum LeadStatus {
  INVITED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITATION
  PAYOUT_DESTINATION
}

enum RegistrationSource {
  SELF
  AGENT_INVITE
  ADMIN
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  role            UserRole
  email           String     @unique
  phone           String?    @unique
  name            String
  passwordHash    String
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  mfaSecretEnc    String?
  /// Last accepted TOTP time step (unix seconds / 30); codes at or before it are replays.
  mfaLastStep     Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions       AuthSession[]
  tokens         VerificationToken[]
  reseller       Reseller?
  agent          Agent?
  auditEvents    AuditEvent[]        @relation("AuditActor")
  supportTickets SupportTicket[]     @relation("TicketOwner")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  tokenHash            String    @unique
  expiresAt            DateTime
  revokedAt            DateTime?
  userAgent            String?
  ipAddress            String?
  mfaPassed            Boolean   @default(false)
  /// Set when an Admin is acting as this user; the session is short-lived and audited.
  impersonatedByUserId String?   @db.Uuid
  /// Admin-supplied justification captured at impersonation start.
  impersonationReason  String?
  createdAt            DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([impersonatedByUserId])
}

model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @db.Uuid
  purpose   VerificationPurpose
  subject   String
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, subject])
  @@index([expiresAt])
}

model Reseller {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerUserId        String             @unique @db.Uuid
  businessName       String
  slug               String             @unique
  status             ResellerStatus     @default(PENDING_VERIFICATION)
  registrationSource RegistrationSource
  onboardingStep     OnboardingStep     @default(PROFILE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner          User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  attribution    ReferralAttribution?
  invitation     ResellerInvitation?
  subscription   Subscription?
  planMigrations PlanMigrationTarget[]
  invoices       SubscriptionInvoice[]
  sites          Site[]
  packages       WifiPackage[]
  customers      Customer[]
  orders         Order[]
  deviceClaims   DeviceClaim[]
  devices        Device[]
  voucherGroups  VoucherGroup[]
  grants         AccessGrant[]
  accruals       CommissionAccrual[]
  promotions     PromotionRequest[]

  @@index([status])
}

model Agent {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @unique @db.Uuid
  referralCode String      @unique
  status       AgentStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  leads        Lead[]
  invitations  ResellerInvitation[]
  attributions ReferralAttribution[]
  policies     CommissionPolicy[]
  accruals     CommissionAccrual[]

  @@index([status])
}

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  agentId      String     @db.Uuid
  businessName String
  contactName  String
  email        String
  phone        String
  consentAt    DateTime
  status       LeadStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  invitation ResellerInvitation?

  @@index([agentId, status])
  @@index([email])
}

model ResellerInvitation {
  id                 String    @id @default(uuid()) @db.Uuid
  leadId             String    @unique @db.Uuid
  agentId            String    @db.Uuid
  tokenHash          String    @unique
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedResellerId String?   @unique @db.Uuid
  createdAt          DateTime  @default(now())

  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  acceptedReseller Reseller? @relation(fields: [acceptedResellerId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([expiresAt])
}

model ReferralAttribution {
  id          String            @id @default(uuid()) @db.Uuid
  resellerId  String            @unique @db.Uuid
  agentId     String            @db.Uuid
  source      AttributionSource
  effectiveAt DateTime          @default(now())
  expiresAt   DateTime?
  reason      String?
  createdAt   DateTime          @default(now())

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  targetType  String
  targetId    String?
  resellerId  String?  @db.Uuid
  reason      String?
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resellerId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  payloadVersion Int       @default(1)
  attempts       Int       @default(0)
  lastError      String?
  dispatchedAt   DateTime?
  nextAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([dispatchedAt, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

// ─────────────────────────── Platform billing ───────────────────────────

enum SubscriptionState {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

/// Draft plans never affect live subscribers; only a published version is served.
enum PlanLifecycle {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Public plans appear in the reseller catalog; private ones are assigned by admin.
enum PlanVisibility {
  PUBLIC
  PRIVATE
}

model PlatformPlan {
  id                String         @id @default(uuid()) @db.Uuid
  code              String
  version           Int
  name              String
  description       String         @default("")
  priceTzs          BigInt
  periodDays        Int
  trialEligible     Boolean        @default(false)
  trialDays         Int?
  /// Legacy per-reseller caps, kept in step with `features.limits`; NULL means unlimited.
  maxSites          Int?
  maxDevices        Int?
  maxPackages       Int?
  /// The feature catalog snapshot for this version, validated by `planFeaturesSchema`.
  features          Json           @default("{}")
  lifecycle         PlanLifecycle  @default(DRAFT)
  visibility        PlanVisibility @default(PUBLIC)
  /// "standard" or "ad_free"; an ad-free promise must disable every sponsored placement.
  commercialPromise String         @default("standard")
  publishedAt       DateTime?
  active            Boolean        @default(true)
  isDemo            Boolean        @default(false)
  createdAt         DateTime       @default(now())

  subscriptions Subscription[]
  invoices      SubscriptionInvoice[]
  migrations    PlanMigration[]

  @@unique([code, version])
  @@index([active])
  @@index([lifecycle, visibility])
}

model Subscription {
  id                 String            @id @default(uuid()) @db.Uuid
  resellerId         String            @unique @db.Uuid
  state              SubscriptionState @default(NONE)
  planId             String?           @db.Uuid
  entitlements       Json?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialUsedAt        DateTime?
  suspendedReason    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  reseller Reseller              @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  plan     PlatformPlan?         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices SubscriptionInvoice[]

  @@index([state, currentPeriodEnd])
}

/// How a published plan version reaches the people already paying.
enum PlanMigrationScope {
  NEW_ONLY
  ON_RENEWAL
  SELECTED
  ALL
}

/// `PARTIAL` means an `ON_RENEWAL` migration still has periods waiting to end.
enum PlanMigrationStatus {
  SCHEDULED
  PARTIAL
  APPLIED
  CANCELLED
}

/// One subscription move per target, so old → new is on the record, not inferred.
model PlanMigrationTarget {
  id              String    @id @default(uuid()) @db.Uuid
  migrationId     String    @db.Uuid
  resellerId      String    @db.Uuid
  fromPlanId      String?   @db.Uuid
  fromCode        String?
  fromVersion     Int?
  appliedAt       DateTime?
  appliedByUserId String?   @db.Uuid

  migration PlanMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  reseller  Reseller      @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@unique([migrationId, resellerId])
  @@index([migrationId, appliedAt])
}

/// A scheduled move of live subscriptions onto a published plan version.
model PlanMigration {
  id              String              @id @default(uuid()) @db.Uuid
  planId          String              @db.Uuid
  scope           PlanMigrationScope
  status          PlanMigrationStatus @default(SCHEDULED)
  /// Nothing moves before this instant.
  effectiveAt     DateTime
  note            String              @default("")
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now())
  appliedAt       DateTime?

  plan    PlatformPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  targets PlanMigrationTarget[]

  @@index([status, effectiveAt])
  @@index([planId])
}

model SubscriptionInvoice {
  id             String        @id @default(uuid()) @db.Uuid
  resellerId     String        @db.Uuid
  subscriptionId String        @db.Uuid
  planId         String        @db.Uuid
  planSnapshot   Json
  amountTzs      BigInt
  periodDays     Int
  status         InvoiceStatus @default(OPEN)
  isFirstPayment Boolean?
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime      @default(now())

  reseller     Reseller            @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  subscription Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         PlatformPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  order        Order?
  accruals     CommissionAccrual[]

  @@index([resellerId, createdAt])
}

// ─────────────────────────── Network inventory ──────────────────────────

enum ControllerMode {
  FAKE
  LIVE
}

enum SiteState {
  REQUESTED
  PROVISIONING
  AWAITING_DEVICE
  READY
  FAILED
  NEEDS_REVIEW
}

enum MappingState {
  PENDING
  PROVISIONING
  PROVISIONED
  MANUAL_REQUIRED
  FAILED
  NEEDS_REVIEW
}

enum DeviceClaimState {
  SUBMITTED
  APPROVED
  REJECTED
  ADOPTION_PENDING
  ADOPTED
  FAILED
}

model Controller {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  type                 String         @default("software")
  mode                 ControllerMode
  baseUrl              String?
  omadacId             String?
  version              String?
  portalTimeSemantics  String?
  credentialsEnc       String?
  credentialKeyVersion Int            @default(1)
  healthStatus         String         @default("unknown")
  lastHealthAt         DateTime?
  lastHealthError      String?
  isDefault            Boolean        @default(false)
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  capabilities ControllerCapability[]
  mappings     ControllerSiteMapping[]
  devices      Device[]
}

model ControllerCapability {
  id           String   @id @default(uuid()) @db.Uuid
  controllerId String   @db.Uuid
  operation    String
  supported    Boolean
  verified     Boolean
  reason       String?
  limits       Json?
  evidence     String?
  updatedAt    DateTime @updatedAt

  controller Controller @relation(fields: [controllerId], references: [id], onDelete: Cascade)

  @@unique([controllerId, operation])
}

model Site {
  id            String    @id @default(uuid()) @db.Uuid
  resellerId    String    @db.Uuid
  name          String
  location      String?
  timezone      String    @default("Africa/Dar_es_Salaam")
  slug          String    @unique
  state         SiteState @default(REQUESTED)
  portalTitle   String?
  portalMessage String?
  landingUrl    String?
  /**
   * Guest-portal look and feel captured in the Captive Portal designer
   * (Reseller → Captive Portal). Shape is validated by `portalThemeSchema` in
   * `@advo/contracts`: brand colors, corner radius and button style.
   */
  portalTheme   Json?
  /**
   * Reseller-editable portal content (advert banner + featured businesses)
   * captured in the Captive Portal designer. Shape is validated by
   * `portalContentSchema` in `@advo/contracts`.
   */
  portalContent Json?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reseller         Reseller                @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  mapping          ControllerSiteMapping?
  claims           DeviceClaim[]
  devices          Device[]
  assignments      PackageSiteAssignment[]
  contexts         PortalContext[]
  grants           AccessGrant[]
  orders           Order[]
  promotions       PromotionRequest[]
  portalPreference SitePortalPreference?

  @@unique([id, resellerId])
  @@index([resellerId, state])
}

/// Plan-governed appearance + visibility choices for one site.
///
/// Stored apart from the reseller's plan on purpose: a downgrade must keep the
/// reseller's choices, narrowing only their *effect*. The shape is validated by
/// `sitePortalPreferenceSchema` in `@advo/contracts`.
model SitePortalPreference {
  id           String   @id @default(uuid()) @db.Uuid
  siteId       String   @unique @db.Uuid
  /// `{ primary_color, accent_color, background_color, theme_preset, logo_url, background_url, show_platform_badge }`
  branding     Json     @default("{}")
  /// The chosen package-card look; NULL means "use the plan's default style".
  packageStyle String?
  /// The chosen arrangement; NULL means "use the plan's default layout".
  packageLayout String?
  /// Ordered package ids; ignored unless the plan allows reordering.
  packageOrder Json     @default("[]")
  /// `{ banner?, explore?, promote_business?, platform_link?, jobs? }`
  visibility   Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model ControllerSiteMapping {
  id           String       @id @default(uuid()) @db.Uuid
  siteId       String       @unique @db.Uuid
  controllerId String       @db.Uuid
  remoteSiteId String?
  remoteName   String
  state        MappingState @default(PENDING)
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  site       Site       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  controller Controller @relation(fields: [controllerId], references: [id], onDelete: Restrict)

  @@unique([controllerId, remoteSiteId])
}

model DeviceClaim {
  id                String           @id @default(uuid()) @db.Uuid
  resellerId        String           @db.Uuid
  siteId            String           @db.Uuid
  name              String?
  mac               String
  model             String?
  hardwareVersion   String?
  serial            String?
  /**
   * Optional local device account (the EAP/Switch login) the Controller uses to
   * adopt the device. The username is stored as-is; the password is encrypted
   * with the same AES-256-GCM helper as Controller credentials (SECRETS_ENCRYPTION_KEY).
   */
  deviceUsername    String?
  devicePasswordEnc String?
  state             DeviceClaimState @default(SUBMITTED)
  reviewReason      String?
  reviewedBy        String?          @db.Uuid
  reviewedAt        DateTime?
  lastError         String?
  deviceId          String?          @unique @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  site     Site     @relation(fields: [siteId, resellerId], references: [id, resellerId], onDelete: Restrict)
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([resellerId, state])
  @@index([mac])
}

model Device {
  id              String    @id @default(uuid()) @db.Uuid
  resellerId      String    @db.Uuid
  siteId          String    @db.Uuid
  controllerId    String?   @db.Uuid
  name            String?
  mac             String    @unique
  model           String?
  hardwareVersion String?
  firmware        String?
  observedStatus  String    @default("unknown")
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reseller   Reseller     @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  site       Site         @relation(fields: [siteId, resellerId], references: [id, resellerId], onDelete: Restrict)
  controller Controller?  @relation(fields: [controllerId], references: [id], onDelete: SetNull)
  claim      DeviceClaim?

  @@index([resellerId, siteId])
}

// ───────────────────────────── Catalogue ────────────────────────────────

enum QuotaType {
  UNLIMITED
  TOTAL
  DAILY
  MONTHLY
}

enum PackageStatus {
  ACTIVE
  ARCHIVED
}

model WifiPackage {
  id                String        @id @default(uuid()) @db.Uuid
  resellerId        String        @db.Uuid
  name              String
  status            PackageStatus @default(ACTIVE)
  currentRevisionId String?       @unique @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reseller        Reseller                @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  revisions       PackageRevision[]       @relation("PackageRevisions")
  currentRevision PackageRevision?        @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  assignments     PackageSiteAssignment[]

  @@unique([id, resellerId])
  @@index([resellerId, status])
}

model PackageRevision {
  id                      String    @id @default(uuid()) @db.Uuid
  packageId               String    @db.Uuid
  resellerId              String    @db.Uuid
  revision                Int
  name                    String
  priceTzs                BigInt
  durationSeconds         Int
  downloadKbps            Int?
  uploadKbps              Int?
  quotaType               QuotaType @default(UNLIMITED)
  quotaBytes              BigInt?
  maxDevices              Int       @default(1)
  activationWindowSeconds Int       @default(86400)
  createdAt               DateTime  @default(now())

  package       WifiPackage    @relation("PackageRevisions", fields: [packageId, resellerId], references: [id, resellerId], onDelete: Restrict)
  currentOf     WifiPackage?   @relation("CurrentRevision")
  voucherGroups VoucherGroup[]
  orders        Order[]
  grants        AccessGrant[]

  @@unique([packageId, revision])
  @@unique([id, resellerId])
}

model PackageSiteAssignment {
  packageId  String   @db.Uuid
  siteId     String   @db.Uuid
  resellerId String   @db.Uuid
  createdAt  DateTime @default(now())

  package WifiPackage @relation(fields: [packageId, resellerId], references: [id, resellerId], onDelete: Cascade)
  site    Site        @relation(fields: [siteId, resellerId], references: [id, resellerId], onDelete: Cascade)

  @@id([packageId, siteId])
  @@index([siteId])
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  resellerId String   @db.Uuid
  phone      String
  firstName  String?
  lastName   String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  orders   Order[]

  @@unique([resellerId, phone])
}

model PortalContext {
  id           String   @id @default(uuid()) @db.Uuid
  tokenHash    String   @unique
  siteId       String   @db.Uuid
  resellerId   String   @db.Uuid
  clientMac    String
  clientIp     String?
  apMac        String?
  gatewayMac   String?
  ssidName     String?
  radioId      String?
  vid          String?
  remoteSiteId String?
  redirectUrl  String?
  corroborated Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  site Site @relation(fields: [siteId, resellerId], references: [id, resellerId], onDelete: Cascade)

  @@index([clientMac])
  @@index([expiresAt])
}

// ────────────────────────── Orders and payments ─────────────────────────

enum OrderPurpose {
  WIFI_PACKAGE
  PLATFORM_SUBSCRIPTION
}

enum OrderPaymentState {
  UNPAID
  PAID
  OVERPAID
  CANCELLED
  REFUND_PENDING
  REFUNDED
  NEEDS_REVIEW
}

enum FulfillmentState {
  NOT_STARTED
  PENDING
  FULFILLED
  FAILED
  NEEDS_REVIEW
}

enum PaymentAttemptState {
  CREATED
  DISPATCHING
  PENDING
  UNKNOWN
  COMPLETED
  FAILED
  VOIDED
  EXPIRED
  NEEDS_REVIEW
}

enum InboxState {
  RECEIVED
  PROCESSED
  QUARANTINED
  IGNORED
  FAILED
}

model Order {
  id                    String            @id @default(uuid()) @db.Uuid
  purpose               OrderPurpose
  resellerId            String            @db.Uuid
  siteId                String?           @db.Uuid
  customerId            String?           @db.Uuid
  packageRevisionId     String?           @db.Uuid
  invoiceId             String?           @unique @db.Uuid
  amountTzs             BigInt
  currency              String            @default("TZS")
  priceSnapshot         Json
  paymentState          OrderPaymentState @default(UNPAID)
  fulfillmentState      FulfillmentState  @default(NOT_STARTED)
  publicTokenHash       String?           @unique
  portalContextId       String?           @db.Uuid
  clientMac             String?
  requestIdempotencyKey String
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  reseller        Reseller             @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  site            Site?                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  packageRevision PackageRevision?     @relation(fields: [packageRevisionId], references: [id], onDelete: Restrict)
  invoice         SubscriptionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  attempts        PaymentAttempt[]
  grant           AccessGrant?

  @@unique([resellerId, requestIdempotencyKey])
  @@index([resellerId, createdAt])
  @@index([paymentState, fulfillmentState])
}

model PaymentAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  orderId           String              @db.Uuid
  provider          String
  providerAccountId String
  providerReference String?
  idempotencyKey    String              @unique
  requestHash       String
  requestPayload    Json
  state             PaymentAttemptState @default(CREATED)
  expiresAt         DateTime?
  amountReceivedTzs BigInt?
  feeTzs            BigInt?
  lastError         String?
  completedAt       DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([providerAccountId, providerReference])
  @@index([state, updatedAt])
  @@index([orderId])
}

model WebhookInboxEvent {
