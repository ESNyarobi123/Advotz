 */
model PromotionRequest {
  id            String                @id @default(uuid()) @db.Uuid
  siteId        String                @db.Uuid
  resellerId    String                @db.Uuid
  packageCode   String
  durationLabel String
  priceTzs      BigInt
  fullName      String
  mobile        String
  email         String?
  business      String
  location      String
  description   String
  offer         String
  state         PromotionRequestState @default(NEW)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  site     Site     @relation(fields: [siteId, resellerId], references: [id, resellerId], onDelete: Cascade)
  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Restrict)

  @@index([siteId, state, createdAt])
  @@index([resellerId, createdAt])
}

enum AdCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/**
 * An admin-created advertising campaign.
 * A campaign is eligible for a placement only when it is `ACTIVE`, its dates
 * allow the current instant, it carries the placement, and its targeting
 * includes the reseller or site being served. Eligibility is decided here so a
 * `REQUIRED` placement can collapse honestly when nothing matches, rather than
 * rendering an empty card.
 */
model AdCampaign {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  status          AdCampaignStatus @default(DRAFT)
  /// Visibility keys this campaign may be served for, e.g. ["ads.banner"].
  placements      String[]
  /// Creative validated by `adCreativeSchema`: business, title, description, cta, theme, imageUrl.
  creative        Json
  /// Targeting: `{ resellerIds?: string[], siteIds?: string[] }`; empty means everyone.
  targeting       Json             @default("{}")
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([placements])
}

/// How a stored asset is used. Kept as a plain string so a new upload surface
/// does not need a migration; the allowed values live in `@advo/contracts`.
enum MediaAssetKind {
  PORTAL_LOGO
  PORTAL_BACKGROUND
  CAMPAIGN_CREATIVE

  @@map("media_asset_kind")
}

/**
 * An uploaded image that has already been through the optimiser.
 *
 * Assets live in Postgres rather than on disk on purpose: the API and worker run
 * as four separate containers with no shared volume, so a file written by one
 * replica would 404 from the next. A row survives every deploy and every replica
 * reads the same bytes.
 *
 * `bytes` holds *only* the optimised image — the raw upload is never written, so
 * the column cannot be used to store an un-processed payload. `originalBytes` and
 * `width`/`height` are kept so the dashboard can show the saving it made.
 */
model MediaAsset {
  id            String         @id @default(uuid()) @db.Uuid
  kind          MediaAssetKind
  /// Tenant that owns the asset, e.g. `RESELLER`.
  ownerType     String
  /// Reseller id for `PORTAL_LOGO`; not a foreign key because the column is shared
  /// by more than one kind of owner.
  ownerId       String
  contentType   String
  /// Optimised bytes. The portal serves exactly these.
  bytes         Bytes
  byteSize      Int
  /// Size of the file the reseller sent, before optimisation.
  originalBytes Int
  originalName  String?
  width         Int
  height        Int
  /// sha256 of `bytes`; used as the serve-time ETag.
  checksum      String
  createdAt     DateTime       @default(now())

  @@index([kind, ownerType, ownerId, createdAt])
}
