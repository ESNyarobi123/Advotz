# LOCAL CONTAINER CHECK ONLY — not a production configuration.
# Runs the production images with fake payment/controller providers and plain HTTP so the
# topology (migrate → api/worker → web/portal → proxy, backups, metrics) can be exercised
# without Snippe or Omada credentials. NODE_ENV stays "development" because production
# startup correctly refuses fake providers. None of these values are secrets.
#
#   docker compose -p advo-local-check --env-file infra/docker/local-check.env \
#     -f infra/docker/compose.prod.yml up -d --build
COMPOSE_PROJECT_NAME=advo-local-check
NODE_ENV=development
APP_NAME="Advo TZ"
BUSINESS_TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_CURRENCY=TZS

WEB_PUBLIC_URL=http://app.localhost:8080
PORTAL_PUBLIC_URL=http://wifi.localhost:8080
API_PUBLIC_URL=http://api.localhost:8080
PROXY_WEB_ADDRESS=http://app.localhost
PROXY_PORTAL_ADDRESS=http://wifi.localhost
PROXY_API_ADDRESS=http://api.localhost
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
HSTS_SNIPPET=nohsts

POSTGRES_DB=advo
POSTGRES_USER=advo
POSTGRES_PASSWORD=local-check-db-password

AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=86400
CSRF_TRUSTED_ORIGINS=http://app.localhost:8080,http://wifi.localhost:8080
SECRETS_ENCRYPTION_KEY=local-check-encryption-key-not-secret
VOUCHER_LOOKUP_HMAC_KEY=local-check-voucher-hmac-not-secret

PAYMENT_PROVIDER=fake
PAYMENTS_MODE=centralized
SNIPPE_WEBHOOK_SECRET=local-check-webhook-secret
OMADA_MODE=fake
NOTIFICATION_PROVIDER=fake
RATE_LIMIT_BACKEND=redis
ADMIN_MFA_REQUIRED=true
METRICS_TOKEN=local-check-metrics-token-not-secret
LOG_LEVEL=info

BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP_DAYS=1
BACKUP_DIR=../../backups/local-check
ADVO_ENV_FILE=./local-check.env
ADVO_IMAGE_TAG=local-check
