# Advo TZ edge proxy.
# WEB_ADDRESS / PORTAL_ADDRESS / API_ADDRESS are full site addresses, e.g.
#   https://app.advo.co.tz   https://wifi.advo.co.tz   https://api.advo.co.tz
# With an https:// address Caddy obtains and renews certificates automatically (ports 80/443
# must reach this host). A plain http:// address disables TLS — local checks only.
#
# Request bodies are streamed to the API unmodified, so Snippe webhook signatures are verified
# over the exact bytes Snippe sent. Caddy discards any client-supplied X-Forwarded-* headers
# (no trusted_proxies configured) and sets its own, which the API trusts via TRUST_PROXY=true.

{
	email admin@advowifi.com
	# Let's Encrypt only. The ZeroSSL fallback was holding the wifi.advowifi.com
	# issuance lock after a failed first attempt, so HTTPS never got a certificate.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(edge) {
	request_body {
		max_size 1MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Metrics and API docs are for the private network only. `/internal/*` holds the
	# web app's server-to-server endpoints: the API reaches them over the Docker
	# network, so no browser has any business there.
	#
	# This must be a `handle`, not a bare `respond`. A bare `respond` sorts *after*
	# every `handle` block in the generated config, so it never ran and these paths
	# reached the apps; the matcher was dead weight. `handle` blocks form one
	# mutually exclusive group evaluated in file order, and this import is first in
	# each site, so it wins before `/api/*` and the catch-all.
	@private path /api/v1/internal/* /api/docs* /internal/*
	handle @private {
		respond 404
	}
	log {
		output stdout
		format json
	}
}

(hsts) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Selected with HSTS_SNIPPET=nohsts for plain-http local checks.
(nohsts) {
}

{$API_ADDRESS} {
	import edge
	import {$HSTS_SNIPPET:hsts}
	reverse_proxy api:4000
}

# Browser apps call the API on their own origin (/api/*), so session cookies stay first-party.
{$WEB_ADDRESS} {
	import edge
	import {$HSTS_SNIPPET:hsts}
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

# The captive portal host must be in the Omada pre-authentication allow-list (walled garden).
{$PORTAL_ADDRESS} {
	import edge
	import {$HSTS_SNIPPET:hsts}
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy portal:3001
	}
}

# Omada builds the captive-portal redirect from the Controller's Portal URL, which carries the
# Controller's *portal* ports:
#   http://<portal host>:<http portal port>/portal/entry?cid=..&ap=..&ssid=..
# The Portal HTTP port is set to 80 (see docs/runbooks.md) because a guest's phone sits behind
# the EAP's pre-authentication firewall, which only lets it reach standard web ports — anything
# else times out with `net::ERR_CONNECTION_TIMED_OUT`. These two listeners stay as fallbacks for
# a Controller that is still pointed at 8088/8843, so a stale config never dead-ends a guest.
:8088 {
	import edge
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy portal:3001 {
			header_up Host wifi.advowifi.com
			header_up X-Forwarded-Host wifi.advowifi.com
			# The client arrived over plain HTTP only because Omada asked for its HTTP portal
			# port. The canonical portal page is HTTPS, so hand back an https:// redirect.
			header_up X-Forwarded-Proto https
		}
	}
}

# Same entry point on the Controller's HTTPS portal port, for a Controller still pointed at it.
# Host is rewritten without the port so the redirect target stays the canonical
# https://wifi.advowifi.com/<slug> page.
wifi.advowifi.com:8843 {
	import edge
	import {$HSTS_SNIPPET:hsts}
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy portal:3001 {
			header_up Host wifi.advowifi.com
			header_up X-Forwarded-Host wifi.advowifi.com
			header_up X-Forwarded-Proto https
		}
	}
}
